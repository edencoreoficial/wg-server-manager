# wgm-panel: painel web do wg-server-manager, iniciado pelo wgm-panel.socket.
# Encerra sozinho apos idle_timeout (panel.conf) e volta no proximo acesso.
#
# Seguranca por Design
# - Roda como root porque o wg-server-manager altera /etc/wireguard e a interface,
#   mas com capacidade unica CAP_NET_ADMIN e sistema de arquivos somente leitura
#   fora de /etc/wireguard e /etc/sysctl.d.
# - ProtectKernelTunables fica desligado de proposito: a criacao do servidor pelo
#   painel precisa ligar net.ipv4.ip_forward.
[Unit]
Description=wgm-panel (painel web do wg-server-manager)
Requires=wgm-panel.socket
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 -I -B /usr/local/lib/wgm-panel/wgm-panel.py
Environment=WGM_PANEL_CONF=/etc/wgm-panel/panel.conf
UMask=0077

CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/etc/wireguard /etc/sysctl.d
ProtectHome=yes
PrivateTmp=yes
DevicePolicy=closed
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native

MemoryMax=96M
TasksMax=32
CPUQuota=50%
